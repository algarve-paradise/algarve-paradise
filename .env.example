# =====================================================================
# Pre-launch gate
# =====================================================================
# true  → visitors see the "Em Breve" page; the real site is only accessible at /visualizar
# false → site is fully public (default)
PRELAUNCH_MODE=false

# =====================================================================
# Supabase
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=news-covers

