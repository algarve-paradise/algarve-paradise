# =====================================================================
# Supabase
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=news-covers

# =====================================================================
# AI Ingestion Pipeline
# =====================================================================
# Default provider — overridable in /admin/configuracoes without redeploy.
# "anthropic" (Claude Haiku 4.5) | "openai" (GPT-4o-mini) | "gemini" (Gemini 2.0 Flash)
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Shared secret for /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=

# Default auto-publish thresholds — overridable in /admin/configuracoes.
AUTO_PUBLISH_AFTER_HOURS=6
AUTO_PUBLISH_MIN_CONFIDENCE=0.75

# Cost guards per ingestion run
INGEST_MAX_ITEMS_PER_SOURCE=5
INGEST_MAX_SOURCES_PER_RUN=10

# =====================================================================
# Stock images for AI-generated drafts
# =====================================================================
# "pexels" (default), "unsplash", or "none" to disable cover lookup.
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
