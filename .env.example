# =====================================================================
# Supabase
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=news-covers

# =====================================================================
# AI Ingestion Pipeline
# =====================================================================
# Provider: "anthropic" (default, Claude Haiku 4.5) or "openai" (GPT-4o-mini)
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared secret for /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=

# Auto-publish: AI drafts older than this and with confidence >= the
# threshold are published automatically by /api/cron/auto-publish.
# Set AUTO_PUBLISH_MIN_CONFIDENCE=0 to publish all expired drafts regardless.
AUTO_PUBLISH_AFTER_HOURS=6
AUTO_PUBLISH_MIN_CONFIDENCE=0.75

# Cost guards per ingestion run
INGEST_MAX_ITEMS_PER_SOURCE=5
INGEST_MAX_SOURCES_PER_RUN=10

# =====================================================================
# Stock images for AI-generated drafts
# =====================================================================
# "pexels" (default), "unsplash", or "none" to disable cover lookup.
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
